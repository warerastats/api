# warerastats GraphQL: root schema (scalars, enums, unions, Query).
#
# Pagination: homogeneous lists take (first, after) and return a plain array;
# page by passing the last element's `id` back as `after` (the _id is the
# time-ordered cursor). The Activity feed uses a small Connection wrapper since
# it is a union. Time-windowed derived data takes (from, to).

scalar DateTime
scalar Int64

enum BattleFilter {
  ALL
  ACTIVE
  FINALIZED
}

enum TradeSide {
  BUY
  SELL
}

enum ItemStatus {
  PERFECT
  ONSALE
  USED
  BROKEN
  DISMANTLED
}

enum Side {
  ATTACKER
  DEFENDER
}

# The family of a polymorphic Entity reference.
enum EntityKind {
  USER
  COUNTRY
  PARTY
  MU
  ALLIANCE
}

# A search hit across the named entity families.
union SearchResult = User | Party | Country | Mu | Alliance

# A polymorphic entity reference used by wealth and battle-damage reports.
union Entity = User | Country | Party | Mu | Alliance

type Query {
  # --- get by id ---
  user(id: ID!): User
  country(id: ID!): Country
  party(id: ID!): Party
  mu(id: ID!): Mu
  region(id: ID!): Region
  battle(id: ID!): Battle
  item(id: ID!): Item
  company(id: ID!): Company
  tradeOffer(id: ID!): TradeOffer
  alliance(id: ID!): Alliance

  # --- search ---
  search(term: String!, limit: Int = 10): [SearchResult!]!

  # --- root lists ---
  battles(first: Int = 20, after: ID, filter: BattleFilter = ALL): [Battle!]!
  countries: [Country!]!
  regions: [Region!]!
  parties(first: Int = 20, after: ID, activeOnly: Boolean = true): [Party!]!
  mus(first: Int = 20, after: ID, activeOnly: Boolean = true): [Mu!]!
  orderBook(itemCode: String!): OrderBook!

  # --- time-series / derived roots ---
  itemCandles(itemCode: String!, from: DateTime!, to: DateTime!): [ItemCandle!]!
  latestItemCandle(itemCode: String!): ItemCandle
  wageCandles(from: DateTime!, to: DateTime!): [WageCandle!]!
  latestWageCandle: WageCandle
  marketStates(from: DateTime!, to: DateTime!): [MarketState!]!
  latestMarketState: MarketState
  wageMarketStates(from: DateTime!, to: DateTime!): [WageMarketState!]!
  latestWageMarketState: WageMarketState
  inflation(from: DateTime!, to: DateTime!): [InflationPoint!]!
  latestInflation: InflationPoint
  dismantleReports(from: DateTime!, to: DateTime!): [DismantleReport!]!
  itemMarketReport(itemCode: String!): ItemMarketReport
  casesReports: [CasesReport!]!
  equipmentPricing(itemCode: String!, windowDays: Int!): EquipmentPricing

  # --- leaderboards ---
  topDamage(from: DateTime!, to: DateTime!, limit: Int = 10): [DamageRanking!]!
  topWageEarners(from: DateTime!, to: DateTime!, limit: Int = 10): [WageRanking!]!
  topWagePayers(from: DateTime!, to: DateTime!, limit: Int = 10): [WageRanking!]!
  topFlippers(limit: Int = 10): [UserFlipState!]!
}

# --- shared leaf types ---

type FloatEntry {
  key: String!
  value: Float!
}

type IntEntry {
  key: String!
  value: Int!
}

type DamageRanking {
  user: User!
  totalDamage: Int64!
  battleCount: Int!
}

type WageRanking {
  user: User!
  total: Float!
  count: Int!
}

type OrderBookLevel {
  price: Float!
  remaining: Int!
}

type OrderBook {
  itemCode: String!
  bids: [OrderBookLevel!]!
  asks: [OrderBookLevel!]!
}
