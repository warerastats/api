# warerastats GraphQL: change-history event types. `at` is derived from the
# event's ObjectID timestamp.

type UserNameChange {
  id: ID!
  at: Time!
  username: String!
  user: User!
}

type UserCountryChange {
  id: ID!
  at: Time!
  user: User!
  country: Country
}

type UserPartyChange {
  id: ID!
  at: Time!
  user: User!
  party: Party
}

type UserCompanyChange {
  id: ID!
  at: Time!
  user: User!
  company: Company
}

type UserMuChange {
  id: ID!
  at: Time!
  user: User!
  mu: Mu
}

type UserSkillChange {
  id: ID!
  at: Time!
  user: User!
  skills: [IntEntry!]!
}

type PartyNameChange {
  id: ID!
  at: Time!
  name: String!
  party: Party!
}

type PartyLeaderChange {
  id: ID!
  at: Time!
  party: Party!
  leader: User!
}

type PartyDescriptionChange {
  id: ID!
  at: Time!
  description: String!
  party: Party!
}

type PartyEthicsChange {
  id: ID!
  at: Time!
  ethics: Ethics!
  party: Party!
}

type CountryRulingPartyChange {
  id: ID!
  at: Time!
  country: Country!
  party: Party
}

type CountrySpecialisationChange {
  id: ID!
  at: Time!
  itemCode: String
  country: Country!
}

type RegionOwnerChange {
  id: ID!
  at: Time!
  region: Region!
  country: Country!
}

type RegionDeposit {
  id: ID!
  at: Time!
  type: String
  startsAt: Time
  endsAt: Time
  bonusPercent: Float
  region: Region!
}

type RegionStrategicResource {
  id: ID!
  at: Time!
  resource: String
  region: Region!
}

type CompanyRegionChange {
  id: ID!
  at: Time!
  company: Company!
  region: Region!
}

type CompanyItemCodeChange {
  id: ID!
  at: Time!
  itemCode: String!
  company: Company!
}

type EmployeeWageChange {
  id: ID!
  at: Time!
  wage: Float!
  user: User!
  company: Company!
}

type MuNameChange {
  id: ID!
  at: Time!
  name: String!
  mu: Mu!
}

type MuOwnerChange {
  id: ID!
  at: Time!
  mu: Mu!
  owner: User!
}

type MuMercenaryReputationChange {
  id: ID!
  at: Time!
  mercRep: Float!
  mu: Mu!
}

type BattleOrderChange {
  id: ID!
  at: Time!
  side: String!
  kind: String!
  action: String!
  battle: Battle!
  entity: Entity
}
