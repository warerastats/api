# warerastats GraphQL: derived / processed analytics output types.

# ---- user ----

type UserFinanceReport {
  id: ID!
  dayStart: DateTime!
  wagesPaid: Float!
  wagesEarned: Float!
  itemsBought: Float!
  itemsSold: Float!
  equipBought: Float!
  equipSold: Float!
  valueDismantled: Float!
  casesOpened: Int!
  casesNet: Float!
  user: User
}

type UserFlipEvent {
  id: ID!
  itemCode: String!
  quantity: Int!
  buyCost: Float!
  sellRevenue: Float!
  profit: Float!
  heldMs: Int64!
  at: DateTime!
  user: User
}

type FlipLot {
  tradeId: ID!
  quantity: Int!
  unitPrice: Float!
  boughtAt: DateTime!
}

type FlipLotGroup {
  itemCode: String!
  lots: [FlipLot!]!
}

type UserFlipState {
  totalFlips: Int!
  totalProfit: Float!
  updatedAt: DateTime!
  openLots: [FlipLotGroup!]!
  user: User
}

type UserInventory {
  updatedAt: DateTime!
  items: [IntEntry!]!
  user: User
}

type UserBattleParticipation {
  totalDamage: Int64!
  battlesParticipated: Int!
  negativeDamage: Int64!
  ownCountryBattles: Int!
  ownCountryParticipated: Int!
  muOrderBattles: Int!
  muOrderParticipated: Int!
  updatedAt: DateTime!
  user: User
}

# ---- country ----

type TaxHijack {
  amount: Float!
