  nonCoreEarned: Float!
  hijackedOut: Float!
  hijackers: [TaxHijack!]!
  foreignTaxIn: Float!
  foreignTaxOut: Float!
  foreignTaxRecipients: [ForeignTaxRecipient!]!
  sources: [TaxSource!]!
  country: Country
}

